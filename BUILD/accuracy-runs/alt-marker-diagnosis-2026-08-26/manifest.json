 ],
 "kind": "read-only diagnosis of the det parser alternative-branch detector",
 "spend_usd": 0.0,
 "gemini_calls": 0,
 "method": "Parsed each PDF in #45's mark_aggregation_overcount bucket with DetParserSettings(escalate_on_mark_mismatch=False) so the question tree survives inspection. ONLY the escalation was disabled. Nothing written; no fixture, corpus file or committed scheme touched.",
 "RUN_35_SUSPICION_REFUTED": {
  "suspicion": "Run 35 recorded, explicitly as suspicion not proof, that 0606_s23_ms_12's leaves worth 16 and 18 marks on an 80-mark paper were 'consistent with total/summary rows ingested as leaves' (16+18=34 against a +36 overcount). It named the confirming test: open those two leaves' text.",
  "test": "Opened both leaves' answer_points and read them.",
  "result": "REFUTED. Neither is a summary row. Both are genuine question content: they are question 9 split across a page break into two same-id leaves, each carrying MULTIPLE ALTERNATIVE SOLUTION METHODS collapsed into one leaf. The 18-mark leaf carries the SAME answer point three times (indices 0, 4 and 10 are byte-identical: 'Shaded area = ... 2ln6+ ...'), once per alternative route.",
  "consequence": "The 16+18=34 vs +36 arithmetic was a coincidence. Recording the refutation so it is not re-tested."
 },
 "DEFECT_FOUND": {
  "summary": "The det alternative-branch detector misses every alternative marker in these papers, so mutually exclusive solution routes are SUMMED instead of being treated as alternatives.",
  "mechanism_at_source": {
   "file": "lemely/io/det/rows.py",
   "lines": "316-330",
   "detail": "The detector fires only when the answer cell EQUALS 'OR'/'EITHER' (rows.py:317) or starts with 'OR '/'EITHER ' — marker plus a SPACE (rows.py:325,328). pdfplumber returns the marker and the following working in ONE cell separated by a NEWLINE, so neither branch matches.",
   "sub_defect_1": "marker followed by '\\n' rather than ' ' or end-of-cell is not matched",
   "sub_defect_2": "the literal word 'Alternative' — which is what CAIE 0606 prints — is not in the marker vocabulary at all, in any form",
   "sub_defect_3": "HARDER, counted in NEITHER bound below: the marker is sometimes not at cell start, e.g. 0606_s23_ms_12 leaf 33b carries '⩽ ⩽\\nAlternative\\n9x2 -28x+3*0' where an operator fragment from the previous row precedes it. The 59 missed markers are therefore themselves a LOWER BOUND."
  },
  "direct_evidence_0606_s23_ms_12": "All 6 alternative markers in the paper are followed by '\\n' and all 82 answer points carry is_alternative=False. Markers: leaf 2[4] 'ALTERNATIVE', leaf 44b[3] 'ALTERNATIVE', leaf 9[2] 'EITHER', leaf 9[6] 'OR', leaf 9[1] 'OR', leaf 9[5] 'ALTERNATIVE'.",
  "why_it_can_only_overcount": "An unflagged alternative adds marks that CAIE never intends to be awarded together, so the defect strictly inflates computed_total. It cannot produce a deficit."
 },
 "PREVALENCE": {
  "population": "#45's mark_aggregation_overcount bucket, 47 papers; 46 parsed, 1 error",
