# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
.venv
venv/
env/
ENV/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Lemely runtime cache
.lemely-cache/

# Build artefacts
build/
dist/
*.egg-info/

# Local tool state
.serena/
.agents/
.codex/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Secrets
.env
.env.local

Sources/
outputs/
lemely.toml
.tokensave
.omc/

# Accuracy harness run output (timestamped, regenerable; .gitkeep stays tracked)
tests/golden/results/*.json

# Supervisor runtime logs + dedup state
BUILD/logs/
BUILD/.supervisor_notify_state
BUILD/.supervisor_reportmark
BUILD/.supervisor_run
BUILD/.supervisor_start
BUILD/.supervisor_phase
BUILD/.supervisor_blockmark
BUILD/.supervisor_claude_pid
BUILD/.supervisor_digest
BUILD/.supervisor_shotmark
# Runtime pause/stop flags — supervisor-owned, must never be committed
BUILD/PAUSE
BUILD/STOP

# Scratch output for routine `./scripts/check.sh` UI-gate runs. Committed phase
# baselines live in reports/phase-N/ and are only written when a re-baseline is
# explicitly requested via LEMELY_REPORT_DIR (see web/e2e/report-dir.ts).
reports/.scratch/

# The Playwright globalSetup seed contract (web/e2e/global-setup.ts) lands in
# whatever LEMELY_REPORT_DIR names, so a phase re-baseline would otherwise
# commit it — and it carries real access tokens for the seeded accounts. They
# are local-stack-only and disposable, but a committed credential is a
# committed credential. The PNGs and audit JSON beside it are the artifacts
# worth keeping; this one is regenerated by every run.
reports/**/e2e-seed.json

# Real solved student scripts used as accuracy fixtures (BUILD/INBOX.md
# 2026-08-07). Genuine handwriting = personal data, and the test that consumes
# them is blocked on the matching official mark schemes anyway (BLOCKERS.md B1),
# so they stay out of history until the human says otherwise — un-ignoring is
# one line; un-committing binary personal data is a history rewrite. This
# doubles as INBOX item 7's "dataset/export exclusion list" entry: these are
# test fixtures only, never served, never bundled.
tests/fixtures/real-papers/
