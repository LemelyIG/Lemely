# lemely.toml — configuration template
#
# Precedence (highest wins): environment variables (LEMELY_*) > .env > this TOML > defaults.
# Nested keys use double-underscore in env vars (e.g. LEMELY_GRADIO__PORT=9000).
# All sections use extra='forbid'; unknown keys raise a validation error at startup.

[gradio]
host = "127.0.0.1"
port = 7860
max_file_size_mb = 25

[paths]
sources_dir = "Sources"
output_dir = "outputs"
cache_dir = ".lemely-cache"

[logging]
level = "INFO"
format = "auto"

[gemini]
model = "gemini-2.5-flash"

# Per-task model overrides (omit a key to use the global `model` above).
# F1 (Gemini 3.x migration, 2026-09-17): these are the shipped defaults, so
# they are commented out here purely as documentation of what you are
# overriding if you uncomment one. correction/escalation default to
# gemini-3.8-flash; extraction/generation/scan_metadata default to
# gemini-3.5-flash-lite; mark_scheme stays on gemini-2.5-flash (its chunked
# parser and thinking_budget tuning predate the 3.x migration, D20). Run
# `lemely doctor` to see what model_for() actually resolves for every tag.
# mark_scheme_model    = "gemini-2.5-flash"
# extraction_model     = "gemini-3.5-flash-lite"
# correction_model     = "gemini-3.8-flash"
# generation_model     = "gemini-3.5-flash-lite"
# scan_metadata_model  = "gemini-3.5-flash-lite"

# Escalation: re-mark with a stronger/thinking-harder model when confidence <
# threshold. Reachable even when escalation_model == correction_model (F1):
# the gate compares (model, thinking) tuples, not model names alone.
# escalation_model = "gemini-3.8-flash"
# escalation_confidence_threshold = 0.8

max_retries = 3
backoff_seconds = 2.0
# Persistent cumulative-USD hard cap (survives process restarts). $14 is the
# shipped default (raised from $8 by the user 2026-09-17, F1/D4).
# total_usd_ceiling = 14.0
# usd_warning_thresholds = [4.0, 6.0]
# Budgets one RUN — every sweep that run drives, not each sweep separately.
# A golden sweep is ~70 calls / ~115k tokens, so 200000 (the old example value)
# was under two sweeps and would abort a legitimate A/B run mid-flight. Size it
# for the whole run; the accuracy programme uses 2000000 (~17 sweeps).
# per_run_token_ceiling = 2000000

# gemini_api_key is a secret — prefer the GEMINI_API_KEY env var instead.
# gemini_api_key = "sk-..."

# Thinking budget per task (tokens; 0 = disabled) — 2.5-and-earlier models
# only. 3.x models read [gemini.thinking_level_for] instead (see below). NOTE:
# TOML table headers stay open until the next one, so every scalar [gemini]
# key must come before this point in the file — [gemini] cannot be reopened
# after a subtable like this one starts.
[gemini.thinking_budget_for]
mark_scheme = 8000
# correction_borderline = 2000  # retry borderline marks before Pro escalation

# Thinking level per task ("minimal"/"low"/"medium"/"high") — 3.x models
# only; a 2.5-and-earlier model ignores this table entirely. Shipped
# defaults shown; "minimal" is only honoured on gemini-3.6-flash /
# gemini-3.5-flash-lite and falls back to "low" on any other 3.x model.
[gemini.thinking_level_for]
correction = "low"
correction_borderline = "high"  # Step-1 retry before Step-2 escalation
escalation = "high"
extraction = "minimal"
generation = "low"

[accuracy_eval]
mark_accuracy_target = 0.95
id_match_rate_target = 0.99
flag_precision_target = 0.99
flag_recall_target = 0.85
# M0.9 (#33) review-rate two-part ratchet gate (spec §4 M0.9, §5).
review_rate_signal_target = 0.08
review_rate_total_target = 0.1
review_rate_p95_target = 0.15
# Unarmed at M0 — a breach is recorded but does not fail the gate.
review_rate_ratchet_armed = false
review_rate_last_merged = 0.4838

[database]
# Full SQLAlchemy URL. Default targets the local Supabase Postgres
# (`supabase start`). Override via LEMELY_DATABASE__URL in production.
url = "postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres"
echo = false
pool_size = 5
max_overflow = 10
pool_pre_ping = true
# Bound how long a connect may block. libpq's own connect_timeout default is
# unlimited, which lets a dropped-packet outage (firewall/security-group
# change) hang every request instead of failing them.
connect_timeout_seconds = 5
pool_timeout_seconds = 5

[supabase]
# Local Supabase Auth (GoTrue). Defaults are the well-known local-dev
# values printed by `supabase status`; override for real deploys.
url = "http://127.0.0.1:54321"
jwt_audience = "authenticated"
# Secrets — prefer LEMELY_SUPABASE__* env vars over this file:
# jwt_secret = "super-secret-jwt-token-with-at-least-32-characters-long"
# anon_key = "..."
# service_role_key = "..."

[storage]
# Object storage for self-mark uploads (P2.5) and profile pictures.
# "local" (the default) writes under `paths.output_dir/storage` — right for
# dev, Compose and CI, and needs no credentials. "gcs" uses Google Cloud
# Storage via Application Default Credentials; no key belongs in this file
# for that path. See docs/deployment.md and scripts/gcp-bootstrap.sh.
#
# There is no Supabase Storage backend — DS7 removed it.
#
# Note that signed URLs (avatar downloads) need a real service-account
# credential (a JSON key, or an attached/workload-identity service account)
# — plain user ADC from `gcloud auth application-default login` can
# upload/download but cannot sign a URL at all. For local signing, add
# `--impersonate-service-account=<runtime SA>` to that login command. The
# "local" backend sidesteps this: it returns the bytes inline instead.
#
# GCS bucket names are ONE GLOBAL namespace across all of Google Cloud, so
# these defaults carry a project-ish prefix. The deployed pipeline overrides
# both per environment (see .github/workflows/deploy.yml), so staging and
# production never share a bucket; `scripts/gcp-bootstrap.sh` creates them.
backend = "local"
bucket = "lemely-uploads"
# Profile pictures live in their own bucket: different retention and access
# shape from scans, and no reason to share a namespace.
avatar_bucket = "lemely-avatars"
signed_url_ttl_seconds = 3600
avatar_max_bytes = 5242880  # 5 MiB
# gcs_project = "my-gcp-project"  # only if ADC can't infer one

[push]
# Web push (VAPID, RFC 8292). All three absent is a SUPPORTED state (D5.9 §4):
# the transport reports itself unavailable, the notification inbox keeps
# working, and every developer machine and CI run is in that state.
#
# Generate a pair with `lemely push-keygen` (prints, writes nothing). The
# public key is handed to every browser and is not a secret; the private key
# is. Deployed, both arrive from GitHub Actions (a repository variable and a
# repository secret) as LEMELY_PUSH__VAPID_PUBLIC_KEY / __VAPID_PRIVATE_KEY.
# ROTATING THE PAIR INVALIDATES EVERY STORED SUBSCRIPTION - the public key is
# baked into each one, so every browser must re-subscribe. See
# docs/push-notifications.md before changing it.
# vapid_public_key = "BASE64URL-65-BYTE-POINT"
# vapid_private_key = "BASE64URL-32-BYTE-SCALAR"
# vapid_subject = "mailto:support@lemelyig.com"
ttl_seconds = 86400
timeout_seconds = 10.0

[auth]
# How long a minted access token is accepted for. Short on purpose: it is a
# bearer credential with no revocation of its own, so this bounds the window
# in which a leaked one is useful. The SPA renews silently in the background
# (POST /api/auth/refresh), so shortening it does not sign anyone out.
access_token_ttl_seconds = 3600
# How long a signed-in device stays signed in without re-entering a
# credential. Long by design — the security is not the expiry but the
# binding: a refresh token names a row in `devices`, so signing that device
# out from the device list, or evicting it past the 3-device cap, kills it
# immediately.
refresh_token_ttl_seconds = 2592000  # 30 days
# OTP challenge lifecycle, shared by channel. The phone channel backs a
# kept-but-unused seam (BUILD/DECISIONS.md D-2026-09-08) for a possible future
# paid SMS channel; no route mints a phone code today.
otp_ttl_seconds = 300
otp_max_attempts = 5
otp_length = 6
otp_min_resend_seconds = 30
# Email-channel OTP challenge lifecycle (spec §4.4). This is the channel that
# ships: parent sign-up codes and email verification codes both use it.
# Longer-lived than the phone lifecycle above; length, attempt cap and resend
# cooldown are shared.
email_otp_ttl_seconds = 600

[grading]
# A teacher_papers row stuck in `processing` past this many seconds is a
# dead run (its instance died) and may be reclaimed by the next regrade.
stale_run_after_seconds = 900

# US-005b's marking gate (US-040, closed by `08df9302`): read by every
# marking path -- the CLI, student paper uploads, the teacher grading job,
# quiz marking, the accuracy harness and Gradio. Enabling it CHANGES HOW
# PAPERS ARE MARKED, on every one of those paths at once. This branch ships
# no accuracy evidence that the verdict path marks better than the legacy
# path -- that evidence needs a label campaign that has not started. Not a
# safe default to flip; leave commented out until that evidence exists.
# Deployed, it is set by LEMELY_GRADING__EQUIVALENCE_GATE; see docs/ci-cd.md.
# equivalence_gate = true
# Error-carried-forward by substitution (I7/US-013). Threaded independently
# of `equivalence_gate` above -- neither flag implies the other -- but it has
# no observable effect unless `equivalence_gate` is ALSO true. Deployed, it
# is set by LEMELY_GRADING__ECF_SUBSTITUTION.
ecf_substitution = false

[integrity]
# Plagiarism detection needs no Gemini key (stdlib difflib only). F4 removed
# the AI-generated-answer detector that used to live here — no evidence base,
# JCQ guidance says a detector must never be sole evidence.
plagiarism_enabled = true
plagiarism_threshold = 0.85

[email]
# Transactional mail for account verification and password reset (D7.7).
#
# Leave `api_key` unset and lemely.web.deps wires MockEmailProvider: the link
# is logged to the `lemely.auth.email` logger instead of sent, and the auth
# routes keep returning it so a local signup completes with no mail service at
# all. That is the supported default for development and CI, not a broken
# state. Setting a key flips both halves at once — mail is really sent, and the
# routes stop returning the live link, because a real sender makes the inbox
# the only place a bearer credential belongs.
#
# NEVER put the key in this file. `lemely.toml` is gitignored, but the key still
# does not belong on disk. Deployed, it is the `RESEND_API_KEY` GitHub Actions
# environment secret, which `deploy.yml` passes to Cloud Run as
# LEMELY_EMAIL__API_KEY. Locally, export LEMELY_EMAIL__API_KEY in your shell.
# api_key = "re_..."
#
# The origin emailed links are built on. AuthService mints links as frontend
# routes (`/verify-email/<token>`), which the SPA can navigate to but an inbox
# cannot resolve — a mail client with no base turns that into
# `http:///verify-email/<token>`. A real provider joins this origin on first.
# deploy.yml sets it per environment; this default is the production site.
app_base_url = "https://lemelyig.com"
#
# Must be on a domain verified with the provider AND carrying that sender's
# SPF/DKIM records in the Cloudflare DNS zone — see docs/email-delivery.md.
from_address = "noreply@lemelyig.com"
from_name = "Lemely"
# Where replies go. Unset means they return to `from_address`, an unattended
# mailbox; point it at a real inbox once one exists.
# reply_to = "support@lemelyig.com"
# Short on purpose: verification mail is a best-effort side effect of an
# already-created account and must never make a signup hang.
timeout_seconds = 10.0

[notifications]
# The in-process sweeper that publishes scheduled announcements and sends the
# two daily engagement notifications (streak_warning at streak_warning_hour,
# study_plan_reminder at study_plan_reminder_hour) in each recipient's OWN
# time zone. It runs inside the API process, started by create_app's lifespan;
# there is no separate worker to deploy. On Cloud Run, timely delivery needs
# --min-instances=1: at zero instances nothing is running to sweep, and a
# 19:00 warning may be missed for that day entirely. See docs/deployment.md.
# The test suite sets LEMELY_NOTIFICATIONS__SWEEPER_ENABLED=0.
sweeper_enabled = true
sweep_poll_seconds = 60
streak_warning_hour = 19
study_plan_reminder_hour = 8
