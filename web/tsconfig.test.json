{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    /* "vite/client" (PR 1B): `tests/unit/clientErrors.test.ts` imports
       `src/lib/clientErrors.ts`, which reads `import.meta.env.DEV` — typed
       only by `vite/client`'s ambient declarations, the same package
       `tsconfig.app.json` already lists here. Without it this project's own
       (separate) typecheck of that file fails on `Property 'env' does not
       exist on type 'ImportMeta'`, even though the app project is fine. */
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode — matches tsconfig.app.json so a test and the module it
       imports are typechecked under the same resolution rules. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Tests import React components directly (S-28's `Announcements.tsx`
       exports its date helpers, S-29's `Standings.tsx` its week/monogram
       helpers), so this project compiles `.tsx` and needs the same JSX
       transform as `tsconfig.app.json`. Without it every such import is
       TS6142 "--jsx is not set".

       This was missing since P5.8 chunk B and did not surface, because
       `tsc -b` is incremental: a `node_modules/.tmp` tsbuildinfo left over
       from before the test existed reported success. `rm -rf
       node_modules/.tmp` before believing a green `tsc -b`. */
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* "src/vite-env.d.ts" (PR 1B): the ambient `declare const __LEMELY_BUILD_ID__:
     string` it carries is a global declaration, visible only to files that are
     actually part of *this* project's own file set — `clientErrors.ts` reaches
     it by import, but an ambient .d.ts with no import/export of its own is not
     pulled in transitively the way a real module is. Listed explicitly so this
     project's typecheck of that file sees the same global the app project does,
     rather than a bare, undeclared identifier. */
  "include": ["tests", "vitest.config.ts", "src/vite-env.d.ts"]
}
