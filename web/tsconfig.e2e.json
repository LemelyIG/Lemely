{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    /* `DOM` as well as `ES2023` because the specs call `page.evaluate(...)`,
       whose callbacks run in the browser and reach `document`/`window`. */
    "lib": ["ES2023", "DOM"],
    /* `node` for the `node:path` / `node:fs` / `node:child_process` imports in
       `seed.ts`, `report-dir.ts` and `global-setup.ts`. Playwright ships its own
       types via `@playwright/test`, which is imported directly rather than
       injected as a global, so it is not listed here. */
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — matches `tsconfig.app.json` and `tsconfig.test.json`.
       Playwright transpiles the specs with its own extensionless resolution, so
       `nodenext` (which would demand `./seed.js`) would report errors the
       runtime does not have. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* D3.20, closed in P6.1: `e2e/` and `playwright.config.ts` were in no
     tsconfig `include` from Phase 3 until Phase 6, so the most expensive gate in
     the build — by then 30 test blocks across 13 files — had never once been
     typechecked. They get their own project rather than joining
     `tsconfig.test.json` because that project is vitest's: it declares
     `vitest/globals`, and a Playwright spec compiled under it picks up vitest's
     ambient `expect`/`test` instead of the ones it imports from
     `@playwright/test`. Two runners, two projects. */
  "include": ["e2e", "playwright.config.ts"]
}
