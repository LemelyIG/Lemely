{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    /* The service worker's own project, and the only reason it exists: `sw.ts`
       needs `WebWorker` types (`ServiceWorkerGlobalScope`, `PushEvent`,
       `NotificationEvent`) while every other file in `src` needs `DOM`. The two
       libs declare overlapping globals with different types, so a single
       project cannot hold both — `tsconfig.app.json` excludes `sw.ts` and this
       project is where it is typechecked.

       Without this split the alternative is leaving the worker untypechecked,
       which is exactly the outcome D5.15 §1 chose `injectManifest` to avoid. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode — matches tsconfig.app.json, since vite builds this file
       with the same resolution rules as the rest of `src`. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `pushDecision.ts` is deliberately compiled in both this project and the app
     project. It is pure data logic that imports no lib-specific global, so it
     is valid under `DOM` and `WebWorker` alike — and typechecking it in both
     places is the point: the page half and the worker half must agree about it.

     It is listed as a single file rather than as the whole `src/lib/push`
     directory, and that distinction is load-bearing. The directory also holds
     `pushClientBridge.ts`, which is **page** code: it reaches `lib/api` and so
     `auth/storage`, which reads `localStorage`. Compiling it here fails with
     `TS2304: Cannot find name 'localStorage'` — which is the type system
     stating exactly the constraint D5.15 §2 is built on, that a service worker
     cannot read the store the session token lives in. Keeping the include
     narrow means that boundary is now enforced by `tsc -b`: any future attempt
     to reach page-only APIs from the worker fails the web-typecheck gate rather
     than failing at runtime on a reader's device. */
  "include": ["src/sw.ts", "src/lib/push/pushDecision.ts"]
}
